    {
        "id": "faaaa09970937a7a",
        "type": "function",
        "z": "tab-orchestration",
        "name": "Init saga context",
        "func": "const correlationId = msg.payload.correlationId || (Math.random().toString(16).slice(2) + Date.now());\n\nmsg.correlationId = correlationId;\nmsg.trace = [];\nmsg.originalPayload = msg.payload;\n\nmsg.trace.push({\n    step: \"intake\",\n    status: \"success\"\n});\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 240,
        "y": 80,
        "wires": [
            [
                "6ed510bf03c088db"
            ]
        ]
    },
    {
        "id": "476090ddd5a4230c",
        "type": "switch",
        "z": "tab-orchestration",
        "name": "Route by orderType",
        "property": "payload.orderType",
        "propertyType": "msg",
        "rules": [

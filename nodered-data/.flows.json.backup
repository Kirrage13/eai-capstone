                "aa099331ad561dbe"
            ]
        ]
    },
    {
        "id": "eh-release-inventory",
        "type": "function",
        "z": "tab-error-handling",
        "name": "Prepare payment refund request",
        "func": "msg.headers = {\n    \"Content-Type\": \"application/json\",\n    \"X-Correlation-Id\": msg.correlationId\n};\n\nmsg.payload = {\n    orderId: msg.orderId,\n    correlationId: msg.correlationId,\n    transactionId: msg.transactionId\n};\n\nmsg._compStepStartedAt = Date.now();\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],

    {
        "id": "8859835e62ac020f",
        "type": "function",
        "z": "tab-orchestration",
        "name": "Build payment failed response",
        "func": "msg.trace.push({\n    step: \"payment\",\n    status: \"failed\",\n    reason: msg.payload.reason || \"Payment declined\",\n    durationMs: Date.now() - msg._stepStartedAt\n});\n\nmsg.statusCode = 422;\n\nmsg.payload = {\n    orderId: msg.orderId,\n    correlationId: msg.correlationId,\n    status: \"failed\",\n    trace: msg.trace\n};\n\nconst traces = global.get(\"orderTraces\") || {};\ntraces[msg.orderId] = msg.trace;\nglobal.set(\"orderTraces\", traces);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],

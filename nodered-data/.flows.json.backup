    {
        "id": "eh-dlq",
        "type": "function",
        "z": "tab-error-handling",
        "name": " Dead Letter Channel",
        "func": "const dlq = global.get(\"deadLetterQueue\") || [];\n\ndlq.push({\n    failedAt: new Date().toISOString(),\n    correlationId: msg.correlationId,\n    orderId: msg.orderId,\n    reason: msg.dlqReason || \"Unhandled processing failure\",\n    payload: msg.payload,\n    trace: msg.trace || []\n});\n\nglobal.set(\"deadLetterQueue\", dlq);\n\nmsg.statusCode = 500;\nmsg.payload = {\n    status: \"dead-lettered\",\n    orderId: msg.orderId,\n    correlationId: msg.correlationId,\n    reason: msg.dlqReason || \"Unhandled processing failure\"\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1700,
        "y": 200,
        "wires": [
            [
                "eh-debug"
            ]
        ]
    },

        "func": "msg.trace.push({\n    step: \"inventory\",\n    status: \"failed\",\n    reason: msg.payload.reason || \"Insufficient stock\",\n    durationMs: Date.now() - msg._stepStartedAt\n});\n\nmsg.compensationReason = \"inventory_failed\";\n\nreturn msg;",
        "outputs": 1,

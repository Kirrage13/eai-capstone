    {
        "id": "c7c5c7b477af476e",
        "type": "function",
        "z": "tab-orchestration",
        "name": "Build completed response",
        "func": "msg.statusCode = 200;\nmsg.payload = {\n    orderId: msg.orderId,\n    correlationId: msg.correlationId,\n    status: \"completed\",\n    trace: msg.trace\n};\n\nconst traces = global.get(\"orderTraces\") || {};\ntraces[msg.orderId] = msg.trace;\nglobal.set(\"orderTraces\", traces);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",

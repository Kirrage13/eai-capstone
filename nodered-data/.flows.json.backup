    {
        "id": "46359ec3a94001de",
        "type": "function",
        "z": "tab-orchestration",
        "name": "Convert XML to canonical payload",
        "func": "const raw = msg.payload;\n\nconst root = raw.order || raw.Order || raw.b2bOrder || raw.B2BOrder || raw;\n\nmsg.payload = {\n    orderType: \"b2b\",\n    customer: root.customer || root.Customer || {},\n    items: root.items || root.Items || [],\n    currency: root.currency || root.Currency || \"EUR\",\n    amount: root.amount || root.Amount || 0\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 720,
        "y": 20,
        "wires": [

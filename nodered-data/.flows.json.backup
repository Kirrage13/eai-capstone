    {
        "id": "8611e9b1f78d3905",
        "type": "function",
        "z": "tab-admin",
        "name": "Get trace by orderId",
        "func": "const orderId = msg.req.params.orderId;\nconst traces = global.get(\"orderTraces\") || {};\nconst trace = traces[orderId];\n\nif (!trace) {\n    msg.statusCode = 404;\n    msg.payload = {\n        error: \"Trace not found\",\n        orderId\n    };\n    return msg;\n}\n\nmsg.statusCode = 200;\nmsg.payload = {\n    orderId,\n    trace\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
